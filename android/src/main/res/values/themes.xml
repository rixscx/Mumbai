<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Colours live in Compose (ui/Theme.kt); this exists only so the window background and
         status bar are the right ink before the first frame draws, avoiding a white flash. -->
    <style name="Theme.Mumbai" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
